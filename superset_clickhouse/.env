# Скопируйте в .env:  cp .env.example .env
# Сгенерировать секретный ключ:  openssl rand -base64 42
SUPERSET_SECRET_KEY=nxfxq9YYAhJnu3+ytaYGSdPUN2Pxu9bsw9HD4BthjZnsGSYc0mfKYBrP

# ClickHouse (если в пароле спецсимволы - при подключении в Superset URL-кодируйте их)
